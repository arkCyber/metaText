# =============================================================================
# metaText .gitignore
# =============================================================================

# ---- Rust / Cargo build artifacts ------------------------------------------
/target/
**/*.rs.bk
*.pdb
*.profraw
*.profdata

# ---- metaText runtime data -------------------------------------------------
# Session snapshot, SQLite databases, logs and other per-user state.
metatext-session.json
*.db
*.db-journal
*.db-shm
*.db-wal
logs/
*.log
# Tox transport state: `toxcore`'s identity/friend list and the transport's own
# durable queue. Both live in the data directory, which is only a checkout when
# it is passed as `--data-dir .`.
tox-savedata.bin
tox-state.json
tox-state.tmp

# ---- Environment / secrets -------------------------------------------------
.env
.env.*
*.pem
*.key

# ---- Editor and OS noise ---------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# ---- Python (the terminal suite under scripts/) ----------------------------
# `scripts/tui-e2e` is imported by its phase scripts, which leaves bytecode next
# to the sources.
__pycache__/
*.py[cod]
